enum DoctorListingStatus {
  INACTIVE
  ACTIVE
  EXPIRED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model DoctorProfile {
  id                  String              @id @default(uuid())
  userId              String              @unique
  licenseNumber       String              @unique
  specialization      String
  experienceYears     Int
  qualificationDocUrl String
  isVerified          Boolean             @default(false)
  verificationStatus  VerificationStatus  @default(PENDING)
  listingStatus       DoctorListingStatus @default(INACTIVE)

  consultationFee Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments     DoctorAppointment[]
  verificationLogs DoctorVerificationLog[]
  reviews          DoctorReview[]

  @@index([listingStatus, isVerified])
}

model DoctorVerificationLog {
  id         String             @id @default(uuid())
  doctorId   String
  action     VerificationStatus
  remarks    String?
  createdAt  DateTime           @default(now())

  // Relations
  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
}

model DoctorAppointment {
  id               String            @id @default(uuid())
  doctorId         String
  patientId        String
  appointmentDate  DateTime
  timeSlot         String
  status           AppointmentStatus @default(PENDING)
  totalPaid        Decimal           @db.Decimal(10, 2)
  commissionAmount Decimal           @db.Decimal(10, 2)
  payoutAmount     Decimal           @db.Decimal(10, 2)
  paymentIntentId  String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relations
  doctor  DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient User          @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  review  DoctorReview?

  @@index([doctorId, appointmentDate])
  @@index([patientId])
}

model DoctorReview {
  id            String   @id @default(uuid())
  doctorId      String
  appointmentId String   @unique
  rating        Int
  comment       String?
  createdAt     DateTime @default(now())

  // Relations
  doctor      DoctorProfile     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointment DoctorAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([doctorId])
}
