enum AnimalStatus {
  OWNED
  LISTED_FOR_SALE
  SOLD
  DECEASED
}

model Animal {
  id          String       @id @default(uuid())
  ownerId     String
  name        String?
  category    String // e.g., "COW", "DOG", "CAT", "BUFFALO"
  breed       String?
  ageMonths   Int?
  gender      String? // "MALE", "FEMALE"
  weightKg    Decimal?     @db.Decimal(8, 2)
  description String?
  status      AnimalStatus @default(OWNED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  owner            User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  listings         CattleListing[]
  vaccinations     VaccinationRecord[]
  breedingRequests BreederProfile[]    @relation("BreederStuds")

  @@index([ownerId, category])
}

model VaccinationRecord {
  id                 String    @id @default(uuid())
  animalId           String
  vaccineName        String
  administeredAt     DateTime
  nextDueDate        DateTime?
  proofDocUrl        Json?
  verifiedByDoctorId String?
  createdAt          DateTime  @default(now())

  // Relations
  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)
  doctor User?  @relation(fields: [verifiedByDoctorId], references: [id])

  @@index([animalId])
}

model Category {
  id            String        @id @default(uuid())
  name          String        @unique
  description   String?
  imageUrl      Json?
  subCategories SubCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubCategory {
  id          String  @id @default(uuid())
  categoryId  String
  name        String  @unique
  description String?
  imageUrl    Json?

  // Relations
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
