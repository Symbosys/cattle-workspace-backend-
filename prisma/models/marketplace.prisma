enum ProductStatus {
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model BrandProfile {
  id           String  @id @default(uuid())
  userId       String  @unique
  brandName    String  @unique
  slug         String  @unique // For URL routing (e.g. /brands/herbo-vet)
  description  String?
  logoUrl      Json? // Stores { url, public_id }
  bannerUrl    Json? // Stores { url, public_id } for store banner
  contactEmail String?
  contactPhone String?
  address      String?
  gstNumber    String? // India GST registration identifier

  isVerified Boolean  @default(false)
  isActive   Boolean  @default(true)
  rating     Decimal  @default(0.00) @db.Decimal(3, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  products       MarketplaceProduct[]
  orderItems     MarketplaceOrderItem[]
  brandLocations BrandLocation[]

  @@index([brandName])
  @@index([slug])
  marketplaceCategories MarketplaceCategory[]
}

model BrandLocation {
  id      String       @id @default(uuid())
  brandId String
  brand   BrandProfile @relation(fields: [brandId], references: [id], onDelete: Cascade)

  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)

  stateId String @unique
  state   State  @relation(fields: [stateId], references: [id])

  cityId String @unique
  city   City   @relation(fields: [cityId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MarketplaceCategory {
  id          String   @id @default(uuid())
  name        String
  brandId     String
  brand       BrandProfile @relation(fields: [brandId], references: [id], onDelete: Cascade)
  description String?
  parentId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  parent   MarketplaceCategory?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: Cascade)
  children MarketplaceCategory[] @relation("CategoryToCategory")
  products MarketplaceProduct[]

  @@index([parentId])
  @@index([isActive])
}

model MarketplaceProduct {
  id              String        @id @default(uuid())
  brandId         String
  categoryId      String
  title           String
  slug            String        @unique // Clean URL SEO slug
  description     String
  status          ProductStatus @default(ACTIVE)
  metaTitle       String?
  metaDescription String?
  images          Json? // Stores list of { url, public_id } review photos
  attributes      Json? // Key-value specifications (e.g. dosage, ingredients)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  brand    BrandProfile        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  category MarketplaceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants ProductVariant[]
  reviews  ProductReview[]

  @@index([brandId])
  @@index([categoryId])
  @@index([status])
}

model ProductVariant {
  id             String   @id @default(uuid())
  productId      String
  sku            String   @unique // Stock Keeping Unit
  title          String // e.g. "10kg Bag", "500ml Bottle"
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2) // Original price/MSRP (strikethrough display)
  stock          Int      @default(0)
  imageUrl       Json? // Stores { url, public_id }
  isActive       Boolean  @default(true)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  product    MarketplaceProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems MarketplaceOrderItem[]

  @@index([productId])
  @@index([isActive])
}

model MarketplaceOrder {
  id              String        @id @default(uuid())
  buyerId         String
  subTotal        Decimal       @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0.00) @db.Decimal(12, 2)
  shippingAmount  Decimal       @default(0.00) @db.Decimal(12, 2)
  taxAmount       Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentIntentId String?       @unique

  shippingAddressId String
  billingAddressId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  buyer           User                   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  shippingAddress UserAddress            @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddress  UserAddress?           @relation("BillingAddress", fields: [billingAddressId], references: [id])
  items           MarketplaceOrderItem[]

  @@index([buyerId])
  @@index([paymentStatus])
}

model MarketplaceOrderItem {
  id             String  @id @default(uuid())
  orderId        String
  variantId      String
  brandId        String // Linked to Brand for direct merchant fulfillment queries
  quantity       Int
  price          Decimal @db.Decimal(10, 2)
  taxAmount      Decimal @default(0.00) @db.Decimal(10, 2)
  discountAmount Decimal @default(0.00) @db.Decimal(10, 2)

  // Fulfillment details (Moved to line items to avoid complex sub-order tables)
  status         OrderStatus @default(PENDING)
  trackingNumber String?
  carrier        String?
  shippedAt      DateTime?
  deliveredAt    DateTime?

  // Relations
  order   MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  brand   BrandProfile     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([variantId])
  @@index([brandId])
  @@index([status])
}

model ProductReview {
  id                 String   @id @default(uuid())
  productId          String
  userId             String
  rating             Int
  comment            String?
  images             Json? // Stores list of { url, public_id } review photos
  isVerifiedPurchase Boolean  @default(false)
  sellerReply        String?
  createdAt          DateTime @default(now())

  // Relations
  product MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  subTotal  Decimal  @default(0.00) @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  cartItems CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  variantId String
  quantity  Int      @default(1)
  total     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}
